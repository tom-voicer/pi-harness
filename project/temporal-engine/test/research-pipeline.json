{
  "name": "Web Research Pipeline",
  "steps": [
    {
      "type": "log",
      "message": "Starting web research on topic: {{vars.input.topic}}"
    },
    {
      "type": "set",
      "variable": "query",
      "value": "{{vars.input.topic}}"
    },
    {
      "type": "web_search",
      "query": "{{vars.query}}",
      "max_results": 3
    },
    {
      "type": "log",
      "message": "Search complete — crawling first result"
    },
    {
      "type": "web_crawl",
      "start_url": "https://zigflow.dev",
      "depth": 1,
      "max_pages": 5
    },
    {
      "type": "log",
      "message": "Crawl complete — extracting content"
    },
    {
      "type": "web_extract",
      "urls": ["https://zigflow.dev/docs/dsl/intro"],
      "format": "markdown"
    },
    {
      "type": "log",
      "message": "✅ Research pipeline complete"
    }
  ]
}
