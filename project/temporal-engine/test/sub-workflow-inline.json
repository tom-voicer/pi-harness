{
  "name": "Sub-Workflow Demo — Inline Definition",
  "input": {
    "userId": 42,
    "sku": "WIDGET-A"
  },
  "steps": [
    {
      "type": "log",
      "message": "🏁 Parent: starting with userId={{vars.input.userId}}, sku={{vars.input.sku}}"
    },

    {
      "type": "workflow_run",
      "definition": {
        "name": "Fraud Check (inline)",
        "input": { "userId": 42, "tier": "premium" },
        "steps": [
          { "type": "log", "message": "🔍 Fraud check for user {{vars.input.userId}} ({{vars.input.tier}})" },
          { "type": "sleep", "duration": 1 },
          { "type": "set", "variable": "approved", "value": true },
          { "type": "log", "message": "✅ Approved" }
        ]
      },
      "result_as": "fraud_result"
    },

    {
      "type": "log",
      "message": "📊 Fraud check completed: {{vars.fraud_result.status}}"
    },

    {
      "type": "workflow_run",
      "definition": {
        "name": "Inventory Check (inline)",
        "steps": [
          { "type": "log", "message": "📦 Checking inventory for {{vars.input.sku}}" },
          { "type": "set", "variable": "in_stock", "value": true },
          { "type": "set", "variable": "quantity", "value": 42 },
          { "type": "log", "message": "✅ In stock: {{vars.quantity}} units" }
        ]
      },
      "input": { "sku": "{{vars.input.sku}}" },
      "result_as": "inventory_result"
    },

    {
      "type": "log",
      "message": "📊 Inventory check completed: {{vars.inventory_result.stepsExecuted}} steps"
    },

    {
      "type": "log",
      "message": "✅ Parent: all sub-workflows complete"
    }
  ]
}
