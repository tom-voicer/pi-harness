{
  "name": "Sub-Workflow Demo — From File",
  "input": {
    "userId": 99,
    "tier": "basic",
    "sku": "GADGET-X"
  },
  "steps": [
    {
      "type": "log",
      "message": "🏁 Parent: running checks for user {{vars.input.userId}} ({{vars.input.tier}})"
    },

    {
      "type": "workflow_run",
      "workflow_file": "../test/fraud-check.json",
      "input": {
        "userId": "{{vars.input.userId}}",
        "tier": "{{vars.input.tier}}"
      },
      "result_as": "fraud_result"
    },

    {
      "type": "log",
      "message": "📊 Fraud check result saved: {{vars.fraud_result.name}} — {{vars.fraud_result.status}}"
    },

    {
      "type": "workflow_run",
      "workflow_file": "../test/inventory-check.json",
      "input": { "sku": "{{vars.input.sku}}" },
      "result_as": "inventory_result"
    },

    {
      "type": "log",
      "message": "📊 Inventory result saved: {{vars.inventory_result.name}}"
    },

    {
      "type": "fork",
      "branches": [
        {
          "name": "parallel_fraud",
          "steps": [
            {
              "type": "workflow_run",
              "definition": {
                "name": "Parallel Fraud Re-check",
                "steps": [
                  { "type": "log", "message": "🔍 Re-checking in parallel branch..." },
                  { "type": "sleep", "duration": 2 },
                  { "type": "log", "message": "✅ Parallel re-check complete" }
                ]
              },
              "result_as": "parallel_fraud"
            }
          ]
        },
        {
          "name": "parallel_inventory",
          "steps": [
            {
              "type": "workflow_run",
              "workflow_file": "../test/inventory-check.json",
              "input": { "sku": "WIDGET-B" },
              "result_as": "parallel_inventory"
            }
          ]
        }
      ]
    },

    {
      "type": "log",
      "message": "✅ Parent: all sub-workflows complete (inline + file + parallel)"
    }
  ]
}
