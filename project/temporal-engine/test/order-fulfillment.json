{
  "name": "Order Fulfillment Pipeline",
  "steps": [
    {
      "type": "set",
      "variable": "customer",
      "value": {
        "name": "Acme Corp",
        "tier": "premium",
        "email": "orders@acme.example.com"
      }
    },
    {
      "type": "set",
      "variable": "lineItems",
      "value": [
        { "sku": "WIDGET-A", "name": "Widget Alpha", "qty": 5, "unitPrice": 49.99 },
        { "sku": "WIDGET-B", "name": "Widget Beta",  "qty": 2, "unitPrice": 149.99 },
        { "sku": "GADGET-X", "name": "Gadget X Pro", "qty": 1, "unitPrice": 399.99 }
      ]
    },
    {
      "type": "set",
      "variable": "shipping",
      "value": { "method": "express", "zip": "94105" }
    },

    {
      "type": "log",
      "message": "Starting order for {{vars.customer.name}} ({{vars.customer.tier}} tier)"
    },

    {
      "type": "set",
      "variable": "totalSavings",
      "value": 0
    },
    {
      "type": "set",
      "variable": "processedItems",
      "value": []
    },

    {
      "type": "for",
      "over": "{{vars.lineItems}}",
      "as": "item",
      "steps": [
        {
          "type": "log",
          "message": "Processing {{vars.item.sku}} — {{vars.item.name}} (qty: {{vars.item.qty}})"
        },

        {
          "type": "set",
          "variable": "warehouseId",
          "value": "WH-{{vars.item.sku}}"
        },

        {
          "type": "if",
          "condition": { "type": "eq", "left": "{{vars.customer.tier}}", "right": "premium" },
          "then": [
            { "type": "set", "variable": "discountPct", "value": 20 },
            { "type": "set", "variable": "discountLabel", "value": "Premium (20%)" }
          ]
        },
        {
          "type": "if",
          "condition": { "type": "eq", "left": "{{vars.customer.tier}}", "right": "standard" },
          "then": [
            { "type": "set", "variable": "discountPct", "value": 10 },
            { "type": "set", "variable": "discountLabel", "value": "Standard (10%)" }
          ]
        },
        {
          "type": "if",
          "condition": { "type": "eq", "left": "{{vars.customer.tier}}", "right": "basic" },
          "then": [
            { "type": "set", "variable": "discountPct", "value": 0 },
            { "type": "set", "variable": "discountLabel", "value": "Basic (0%)" }
          ]
        },

        {
          "type": "set",
          "variable": "lineSubtotal",
          "value": "{{vars.item.qty}} * {{vars.item.unitPrice}}"
        },

        {
          "type": "log",
          "message": "  → Subtotal: {{vars.lineSubtotal}} | Discount: {{vars.discountPct}}% | Label: {{vars.discountLabel}}"
        },

        {
          "type": "set",
          "variable": "totalSavings",
          "value": "{{vars.totalSavings}} + {{vars.lineSubtotal}}"
        }
      ]
    },

    {
      "type": "if",
      "condition": { "type": "gt", "left": "{{vars.totalSavings}}", "right": 500 },
      "then": [
        {
          "type": "log",
          "message": "Subtotal exceeds $500 — manager approval required"
        },
        {
          "type": "sleep",
          "duration": 2
        },
        {
          "type": "set",
          "variable": "approvalStatus",
          "value": "auto-approved"
        }
      ],
      "else": [
        {
          "type": "log",
          "message": "Subtotal under $500 — no approval needed"
        },
        {
          "type": "set",
          "variable": "approvalStatus",
          "value": "not-required"
        }
      ]
    },

    {
      "type": "http",
      "method": "GET",
      "url": "https://jsonplaceholder.typicode.com/posts/1"
    },

    {
      "type": "fork",
      "branches": [
        {
          "name": "payment",
          "steps": [
            { "type": "log", "message": "💳 Charging payment..." },
            { "type": "http", "method": "GET", "url": "https://jsonplaceholder.typicode.com/posts/2" },
            { "type": "set", "variable": "paymentStatus", "value": "charged" },
            { "type": "log", "message": "💳 Payment complete" }
          ]
        },
        {
          "name": "inventory",
          "steps": [
            { "type": "log", "message": "📦 Reserving inventory..." },
            { "type": "sleep", "duration": 2 },
            { "type": "set", "variable": "inventoryStatus", "value": "reserved" },
            { "type": "log", "message": "📦 Inventory reserved" }
          ]
        },
        {
          "name": "notification",
          "steps": [
            { "type": "log", "message": "📧 Sending confirmation to {{vars.customer.email}}..." },
            { "type": "sleep", "duration": 1 },
            { "type": "set", "variable": "emailSent", "value": true },
            { "type": "log", "message": "📧 Confirmation sent" }
          ]
        }
      ]
    },

    {
      "type": "log",
      "message": "✅ Order fulfilled — approval: {{vars.approvalStatus}}"
    }
  ]
}
