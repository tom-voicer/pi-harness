# email_me extension configuration
# Copy this file to .env and fill in your values.
# Environment variables take precedence over this file.

# SMTP server host (default: smtp.gmail.com)
# EMAIL_ME_HOST=smtp.gmail.com

# SMTP port (default: 587 for TLS, use 465 for SSL)
# EMAIL_ME_PORT=587

# Your email address (SMTP login)
EMAIL_ME_USER=you@gmail.com

# Your SMTP password or Gmail app password (no spaces)
EMAIL_ME_PASS=xxxx-xxxx-xxxx-xxxx

# Default recipient (where notifications are sent)
EMAIL_ME_TO=you@gmail.com

# Optional: custom "From" address (default: same as EMAIL_ME_USER)
# EMAIL_ME_FROM=pi@yourdomain.com

# Optional: prefix added to subject lines (default: [pi])
# EMAIL_ME_SUBJECT_PREFIX=[pi]
